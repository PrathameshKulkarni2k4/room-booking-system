# RoomBuddy backend — environment template.
# Copy to .env for local development. NEVER commit a real .env.

# --- Server ---
PORT=8000
NODE_ENV=development

# --- CORS ---
# Comma-separated allow-list. CORS_ORIGIN (single) is also supported.
CORS_ORIGINS=http://localhost:5173

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# --- Auth (use long random strings) ---
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace-with-another-long-random-string
REFRESH_TOKEN_EXPIRY=7d

# --- Media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_KEY=your-api-key
CLOUDINARY_CLOUD_SECRET=your-api-secret

# --- Email (Resend) ---
RESEND_API_KEY=your-resend-api-key
MAIL_FROM=RoomBuddy <no-reply@yourdomain.com>

# --- Payments (Razorpay, test mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-test-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-signing-secret

# --- Cache / rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
